builddir = .build

poni_h_path = /home/emdash/Documents/ponygame/poniescript/poniescript
poniescript = /home/emdash/Documents/ponygame/poniescript/target/debug/poniescript

rule poni-regenerate
  command = ponies regenerate
  generator = true
  description = ponies regenerate

build .build/build.ninja: poni-regenerate ponies.toml
rule link-web-debug
  command = wasm-ld $in -o $out -L/home/emdash/Documents/ponygame/poniescript/target/wasm32-unknown-unknown/debug -l$runtime_lib  --export-all --allow-undefined --no-demangle -z stack-size=1048576 --stack-first
  description = [0;34mlink[0m[2m.web.debug[0m -> $outdesc
rule hot-link-web-debug
  command = wasm-ld $in -o $out -shared 
  description = [0;34mhot [0m[2m.web.debug[0m -> $outdesc
rule cc-web-debug
  command = clang -c $in -o $out -MD -MF $out.d -I$poni_h_path -I.  -target wasm32 -DPONI_WASM32 -nostdinc -nostdlib
  depfile = $out.d
  deps = gcc
  description = [0;32mcc  [0m[2m.web.debug[0m $indesc
rule cargo-web-debug
  command = cargo build --manifest-path $cargotoml -p $package --target wasm32-unknown-unknown
  description = [0;31mrust[0m[2m.web.debug[0m $package
rule poni-web-debug
  command = $poniescript $outputargs $in $imports --no-timing
  description = [0;35mponi[0m[2m.web.debug[0m $indesc
build .build/web-debug/game: link-web-debug .build/web-debug/game-0.o | /home/emdash/Documents/ponygame/poniescript/target/wasm32-unknown-unknown/debug/libponyquad.a
  outdesc = game
  runtime_lib = ponyquad
build .build/web-debug/game.so: hot-link-web-debug .build/web-debug/hot-game-0.o
  outdesc = game
build .build/web-debug/game-0.o: cc-web-debug .build/web-debug/game-0.c | $poni_h_path/poni/poni.h $poni_h_path/poni/poni_standalone.h $poni_h_path/poni/poni_gc.h
  indesc = game-0.c
build .build/web-debug/hot-game-0.o: cc-web-debug .build/web-debug/hot-game-0.c | $poni_h_path/poni/poni.h $poni_h_path/poni/poni_standalone.h $poni_h_path/poni/poni_gc.h
  indesc = hot-game-0.c
build .build/web-debug/game-0.c: poni-web-debug game.poni screen.poni update_smoothing.poni physics.poni /home/emdash/Documents/ponygame/poniescript/ponyquad/keycodes.poni
  imports = -i /home/emdash/Documents/ponygame/poniescript/ponyquad/ponyquad.h -e --bind-fun update --disable-gc-frames
  outputargs = -o .build/web-debug/game-0.c
  indesc = game

build .build/web-debug/hot-game-0.c: poni-web-debug game.poni screen.poni update_smoothing.poni physics.poni /home/emdash/Documents/ponygame/poniescript/ponyquad/keycodes.poni
  imports = -i /home/emdash/Documents/ponygame/poniescript/ponyquad/ponyquad.h -e --hot --bind-fun update --disable-gc-frames
  outputargs = -o .build/web-debug/hot-game-0.c
  indesc = game

build /home/emdash/Documents/ponygame/poniescript/target/wasm32-unknown-unknown/debug/libponyquad.a : cargo-web-debug
  package = ponyquad
  cargotoml = /home/emdash/Documents/ponygame/poniescript/Cargo.toml

build web-debug: phony .build/web-debug/game

