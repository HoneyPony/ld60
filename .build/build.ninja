rule link-local-debug
  command = clang -fuse-ld=mold -lasound $in -o $out -L/home/emdash/Documents/ponygame/poniescript/target/debug -l$runtime_lib  -lm
  description = [0;34mlink[0m[2m.local.debug[0m -> $outdesc
