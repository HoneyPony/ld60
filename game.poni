    // world_loader.load_world("level/level_intro_jumping.json");
    world_loader.load_world("level/level_begin_game.json");
}

class CameraController {
    var x_bound: vec2 = (0, 0);
    var y_bound: vec2 = (0, 0);

    fun ready_draw(player_pos: vec2) {
        let min_x = x_bound.0 + screen.target_size.x / 2;
        let max_x = x_bound.1 - screen.target_size.x / 2;

        let min_y = y_bound.0 + screen.target_size.y / 2;
        let max_y = y_bound.1 - screen.target_size.y / 2;

        var x = player_pos.x;
        var y = player_pos.y;
        if x < min_x { x = min_x; }
        if x > max_x { x = max_x; }
        if max_x < min_x {
            x = (min_x + max_x) / 2;
        }

        if y < min_y { y = min_y; }
        if y > max_y { y = max_y; }
        if max_y < min_y {
            y = (min_y + max_y) / 2;
        }

        screen.target_offset = -(x, y);

        // Draw a bordering black rectangle around the entire map.
        // This is so we don't have to manually set this up in Tiled.
        //let map = world_loader.cur_map else return;
        let size = world_loader.map_size * 16;
        let TILE_DARK_BORDER = (#1c1c1bff);
        let BORDER_SIZE = 16 * 32;
        // left and right strips
        draw_rectangle((x_bound.0 - BORDER_SIZE, -BORDER_SIZE), (BORDER_SIZE, size.y + BORDER_SIZE * 2), TILE_DARK_BORDER);
        draw_rectangle((x_bound.1, -BORDER_SIZE), (BORDER_SIZE, size.y + BORDER_SIZE * 2), TILE_DARK_BORDER);
        // top and bottom strips
        draw_rectangle((-BORDER_SIZE, y_bound.0 - BORDER_SIZE), (size.x + BORDER_SIZE * 2, BORDER_SIZE), TILE_DARK_BORDER);
        draw_rectangle((-BORDER_SIZE, y_bound.1), (size.x + BORDER_SIZE * 2, BORDER_SIZE), TILE_DARK_BORDER);
    }
}
let camera_controller = new CameraController{};

/// Helper for key just pressed checking due to weird update() system.
class Key {
    var was_down: bool = false;
    var is_down: bool = false;
    var is_just_pressed: bool = false;
    let keycode: int;

    fun update() {
        was_down = is_down;
        is_down = is_key_down(keycode);
        is_just_pressed = is_down and not was_down;
    }
}

let key_space = new Key { keycode: K_SPACE };
let key_x = new Key { keycode: K_X };
let key_r = new Key { keycode: K_R };
let key_z = new Key { keycode: K_Z };
let keys = [key_space, key_x, key_r, key_z];

var rescue_horse: Actor? = nil;

class Animation {
    let frames: Array[int];
    var frame: int = 0;
    var frame_duration: float;
    var accumulator: float = 0;

    fun update_dt(dt: float) {
        accumulator += dt;
        if accumulator >= frame_duration {
            accumulator -= frame_duration;
            frame = (frame + 1) % frames.length;
        }
    }

    fun get_frame() -> int { frames[frame] }
}

fun gravity(y_vel: float, dt: float) -> float {
    y_vel += dt * 500.0;
    if y_vel > 200 {
        y_vel = 200;
    }
    y_vel
}

class Player {
    // Note to self: it could be useful to have some way to have a variable that we can somehow
    // initialize in a safe way, so that we don't need these dummy values to keep it non-nullable...
    var actor: Actor = new Actor{collider: new Collider{size:(0, 0), pos: (0, 0)}};

    var speed: vec2 = (0, 0);
    var flip_h: bool = false;
    var frame: int = 0; // Current animation frame

    let run_anim = new Animation { frames: [1, 2], frame_duration: 0.1 };

    var jump_timer: float = 0;
    var coyote_time: float = 0;

    var hide: bool = false;

    fun update_dt(dt: float) {
        let JUMP_VEL = -190.0;
        let JUMP_TIMER_MAX = 0.18;

        run_anim.update_dt(dt);

        let on_ground = actor.collider.on_ground; //world.collide_check(actor, actor.collider.pos + (0, 1));
        let on_ceiling = actor.collider.on_ceiling;//world.collide_check(actor, actor.collider.pos - (0, 1));

        let use_h_frame = if not on_ground {
            let grav_multiplier = if speed.y > 0 and speed.y < 10 {
                // Smooth out tips of jumps by reducing gravity
                0.3
            } else { 1.0 };

            speed.y = gravity(speed.y, dt * grav_multiplier);
            frame = if speed.y > 0 { 4 } else { 3 };
            false
        }
        else {
            coyote_time = dt * 3.2; // Should always be 4 frames I think
            true
        };

        if on_ceiling and speed.y < 0 {
            speed.y = 0;
        }

        // If we ever bonk, kill the jump.
        if speed.y >= 0 {
            jump_timer = 0;
        }

        if is_key_down(K_LEFT) {
            speed.x = -100;
            flip_h = true;
        }
        else if is_key_down(K_RIGHT) {
            speed.x = 100;
            flip_h = false;
        }
        else {
            speed.x = 0;
        }

        if hide { speed.x = 0; }

        if use_h_frame {
            if speed.x != 0 {
                frame = run_anim.get_frame();
            }
            else {
                frame = 0;
            }
        }

        if (key_space.is_just_pressed or key_z.is_just_pressed) and coyote_time > 0 {
            jump_timer = JUMP_TIMER_MAX;
        }
        if coyote_time > 0 {
            coyote_time -= dt;
        }

        if jump_timer > 0 {
            speed.y = JUMP_VEL;
            jump_timer -= dt;

            if not (key_space.is_down or key_z.is_down) {
                jump_timer = 0;
                speed.y *= 0.5;
            }
        }

        world.move_h(actor, speed.x * dt);
        world.move_v(actor, speed.y * dt, true);

        if key_x.is_just_pressed {
            // Try to eat a carrot.
            eat_carrot();
        }

        let area_check = world.collide_layer_point(areas_layer, actor.collider.pos + (8, 8));
        if area_check == T_SOLID {
            // Victory square, for now.
            // Check if the rescue horse is also in the level.
            if check_rescue_horse() { world_loader.advance_level(); }
        }

        if key_r.is_just_pressed {
            world_loader.reload();
        }
    }

    fun check_rescue_horse() -> bool {
        let horse = rescue_horse else return true; ; // TODO: Don't make this require double-semicolon

        let check = world.collide_layer_point(areas_layer, horse.collider.pos + (8, 8));
        return check == T_SOLID;
    }

    fun eat_carrot() {
        let map = world_loader.cur_map else return;
        let pos = round2(actor.collider.pos / 16);
        let tile = get_tile_map_tile(map, MAIN_LAYER, pos);

        if tile == 27 {
            // Eat the carrot.
            set_tile_map_tile(map, MAIN_LAYER, pos, 24);

            for i in 0..plant_detect_v.length {
                plant_detect_v[i].carrot(pos);
            }
        }
    }

    fun draw() {
        if hide { return; }
        // draw_rectangle(actor.collider.pos, (16, 16), (#ffff));
        var offset_from_16 = ((16 - PLAYER_ACTOR_SIZE.x) / 2, 16 - PLAYER_ACTOR_SIZE.y);
        draw_texture_flip_frame(tex.horse1, actor.collider.pos + (-2, 0) - offset_from_16, flip_h, false, (frame * 20, 0, 20, 16), (#ffff));
    }
}

class Crate {
    let actor: Actor;
    var speed: vec2 = (0, 0);
    let is_horse: bool = false;
    var anim: float = -1.0;
    var horse_spawn_point: vec2i = (0, 0);

    var is_player_horse: bool = false;

    fun check_unfreeze() {
        let map = world_loader.cur_map else return;
        let tile_coord = round2((actor.collider.pos) / 16);
        let tile = get_tile_map_tile(map, "bg", tile_coord);
        if tile == 75 {
            var dist = actor.collider.pos - tile_coord * 16;
            if abs(dist.x) < 2 and abs(dist.y) < 2 {
                actor.collider.pos = tile_coord * 16;
                horse_spawn_point = tile_coord;
                anim = 0.0;
            }
            
        }
    }

    fun update_dt(dt: float) {
        if anim >= 0.0 {
            anim += dt;
            if anim >= 1.0 {
                if is_player_horse {
                    player.actor.collider.pos = horse_spawn_point * 16;
                }
                else {
                    let map = world_loader.cur_map;
                    if map.is_some() {

                        set_tile_map_tile(map.or_panic(), MAIN_LAYER, horse_spawn_point, 61);
                        

                    }
                }

                for i in 0..text_objects.length {
                    text_objects[i].hide = false;
                }
                player.hide = false;

                remove();
            }
            return;
        }

        if is_horse {
            check_unfreeze();
        }

        let on_ground = actor.collider.on_ground; 
        if on_ground { speed.y = 0; }
        else {
            speed.y = gravity(speed.y, dt);
        }

        world.move_v(actor, speed.y * dt, true);
    }

    fun get_tile() -> int {
        if is_horse {
            if is_player_horse { 16 * 3 }
            else { 16 * 2 }
        }
        else { 16 }
    }

    fun draw() {
        var color = (#ffff);
        if anim >= 0.0 {
            color = lerp(color, (#ff843273), anim);
        }
        draw_texture_flip_frame(tex.tiles, actor.collider.pos, false, false, (get_tile(), 16, 16, 16), color);
        if anim >= 0.0 {
            draw_texture_flip_frame(tex.tiles, actor.collider.pos, false, false, (64, 112, 16, 16), (1, 1, 1, if anim > 1 { 1 } else { anim }));
        }
    }

    fun remove() {
        let new_crates: DynArray[Crate] = [];
        for i in 0..crates_pending.length {
            if crates_pending[i] != self {
                new_crates.push(crates_pending[i]);
            }
        }
        crates_pending = new_crates;
    }
}

class MovingPlatform {
    let solid: Solid;
    let start_point: vec2;
    let end_point: vec2;
    let speed: float;

    fun update_dt(dt: float) {
        // How do we decide when to move back, etc...?
        let motion = end_point - start_point;
        var frame_motion = norm2(motion) * speed * dt;
        if len2(frame_motion) > len2(motion) {
            frame_motion = motion;
        }
        world.solid_move(solid, frame_motion);
    }

    fun draw() {
        draw_texture_flip_frame(tex.tiles, solid.collider.pos, false, false, (16, 32, 16, 16), (#ffff));
    }
}



class PlantDetectV {
    let solid: Solid;
    let min_y: float;
    let max_y: float;
    let height: int;
    let eyeball_offset: int;

    var target_y: float;

    fun update_dt(dt: float) {
        // How do we decide when to move back, etc...?
        let motion = target_y - solid.collider.pos.y;
        var frame_motion: float = dt * 16 * 8 * signumf(motion);
        if abs(frame_motion) > abs(motion) {
            frame_motion = motion;
        }
        world.solid_move(solid, (0, frame_motion));
    }

    fun draw() {
        for i in 0..height {
            var tile_x = 32;
            if i != eyeball_offset { tile_x += 16; }
            draw_texture_flip_frame(tex.tiles, solid.collider.pos + (0, i * 16), false, false, (tile_x, 32, 16, 16), (#ffff));
        }
    }

    fun carrot(tile_pos: vec2i) {
        let pos = tile_pos * 16;
        if pos.y >= min_y and pos.y <= max_y {
            target_y = pos.y - eyeball_offset * 16;
        }
    }
}

class TextObject {
    var text: StrBuf;
    var pos: vec2;
    var hide: bool;

    fun draw() {
        if hide { return; }
        draw_text_font(text, main_font, pos, 16, (#000f));
    }
}

var crates: DynArray[Crate] = [];
var crates_pending: DynArray[Crate] = [];
var moving_platforms: DynArray[MovingPlatform] = [];
var plant_detect_v: DynArray[PlantDetectV] = [];
var text_objects: DynArray[TextObject] = [];

class WorldLoader {
    var pending: StringLoader? = nil;
    var cur_map: Map? = nil;
    var map_size: vec2i = (0, 0);
    var should_load = false;

    var level_idx: int = 0;
    var won: bool = false; // Set when we make the first call to advance_level() this level.

    fun load_world(path: StrBuf) {
        pending = load_string(path);
        should_load = true;
        screen_transition.trigger();
    }

    fun reload() {
        should_load = true;
        // NOTE: This will not overwrite an advance_level() because we already set should_load in
        // load_world.
        screen_transition.trigger();
        screen_transition.waiting_on_world = true;
    }

    fun advance_level() {
        if won { return; }
        won = true;

        if level_idx + 1 < level_list.length { level_idx += 1; }
        load_world(level_list[level_idx]);
        screen_transition.trigger();
        screen_transition.waiting_on_world = true;
    }

    fun tick() {
        if not should_load { return; }
        if not screen_transition.is_ready() { return; }

        let pending_ = pending else return;
        let data = get_loaded_string(pending_);
        let data = data else return;

        print(data);

        let a: StrBuf = "../tex/tiles.png";
        let map = load_map(data, [a], [tex.tiles]);

        print("loaded? ", map.is_some());

        cur_map = map;

        // Somehow this caused a crash. It works now, but we use should_load
        // so that we don't have to re-do the load_string rigamarole for reload().
        // pending = nil;
        should_load = false;

        let map = map else return;
        map_size = get_tile_map_size(map);

        physics_layer.colliders = [];
        physics_layer.width = map_size.x;

        areas_layer.colliders = [];
        areas_layer.width = map_size.x;
        world.actors = [player.actor];
        world.solids = [];

        // Clear ALL the arrays.
        crates = [];
        crates_pending = [];
        moving_platforms = [];
        plant_detect_v = [];
        text_objects = [];
        rescue_horse = nil;

        screen_transition.waiting_on_world = false;

        won = false;

        camera_controller.x_bound.0 = 0;
        camera_controller.x_bound.1 = map_size.x * 16;
        camera_controller.y_bound.0 = 0;
        camera_controller.y_bound.1 = map_size.y * 16;

        for y in 0..map_size.y {
            for x in 0..map_size.x {
                var tile = get_tile_map_tile(map, MAIN_LAYER, (x, y));
                
                fun map_to_physics(tile: int) -> int {
                    if tile == -1 or tile == 0 { return T_EMPTY; }
                    if tile >= 24 and tile <= 31 {
                        return T_EMPTY;
                    }
                    if tile >= 32 and tile <= 39 {
                        return T_SOLID_THIN;
                    }
                    if tile >= 40 and tile <= 63 {
                        return T_EMPTY;
                    }
                    return T_SOLID;
                }

                // Crate
                if tile == 9 or tile == 10 or tile == 11 {
                    //world.add_solid((x, y) * 16 + (1, 1), (14, 14));
                    let actor = world.add_actor((x, y) * 16, (16, 16));
                    let crate = new Crate { actor: actor, is_horse: tile == 10 or tile == 11 };
                    crates.push(crate);
                    if tile == 10 {
                        rescue_horse = actor;
                    }
                    if tile == 11 {
                        // TODO: Hide the main horse
                        player.hide = true;
                        crate.is_player_horse = true;
                    }
                    print(set_tile_map_tile(map, MAIN_LAYER, (x, y), 0));
                    print(get_tile_map_tile(map, MAIN_LAYER, (x, y)));
                    tile = 0;
                }

                

                // if tile == 17 {
                //     let solid = world.add_solid((x, y) * 16, (16, 16));
                //     moving_platforms.push(new MovingPlatform { solid: solid });
                //     set_tile_map_tile(map, "Tile Layer 1", (x, y), 0);
                //     tile = 0;
                // }

                physics_layer.colliders.push(map_to_physics(tile));

                // Check for camera bounds
                let tile = get_tile_map_tile(map, "utility", (x, y));
                if tile == 73 {
                    camera_controller.y_bound.0 = y * 16;
                }
                if tile == 74 {
                    camera_controller.y_bound.1 = y * 16 + 16;
                }
                if tile == 81 {
                    camera_controller.x_bound.0 = x * 16;
                }
                if tile == 82 {
                    camera_controller.x_bound.1 = x * 16 + 16;
                }

                areas_layer.colliders.push(if tile == 80 { T_SOLID } else { T_EMPTY });
            }
        }

        let count = tiledobj_get_count(map, "moving");
        for i in 0..count {
            let type = tiledobj_get_tile_id(map, "moving", i);
            if type == 18 {
                let offset_x = tiledobj_get_property_float(map, "moving", i, "offset_x");
                let offset_y = tiledobj_get_property_float(map, "moving", i, "offset_y");
                let speed = tiledobj_get_property_float(map, "moving", i, "speed");
                let pos = tiledobj_get_position(map, "moving", i);

                let solid = world.add_solid(pos, (16, 16));
                moving_platforms.push(new MovingPlatform {
                    solid: solid,
                    start_point: pos,
                    end_point: pos + (offset_x, offset_y) * 16,
                    speed: speed * 16,
                });
            }

            if type == 19 {
                let height = tiledobj_get_property_int(map, "moving", i, "height");
                let max_movement_y = tiledobj_get_property_int(map, "moving", i, "max_movement_y");
                let eyeball_offset = tiledobj_get_property_int(map, "moving", i, "eyeball_offset");
                let pos = tiledobj_get_position(map, "moving", i);
                let offset_y = tiledobj_get_property_int(map, "moving", i, "start_offset");

                let pos = pos + (0, -16); // Fix tiled janky coordinates

                var min_y = pos.y;
                var max_y = pos.y + max_movement_y * 16;
                if max_movement_y < 0 {
                    let tmp = min_y;
                    min_y = max_y;
                    max_y = tmp;
                }

                let solid = world.add_solid(pos + (0, offset_y * 16), (16, 16 * height));
                plant_detect_v.push(new PlantDetectV {
                    solid: solid,
                    height: height,
                    min_y: min_y,
                    max_y: max_y,
                    target_y: pos.y + offset_y * 16, // apply start_offset if we had it
                    eyeball_offset: eyeball_offset,
                });
            }
        }

        let count = tiledobj_get_count(map, "player");
        for i in 0..count {
            // Assume that these objects are all the player spawn postiion.
            let pos = tiledobj_get_position(map, "player", i) + (0, -16); // Fix to janky tiled coordinates
            player.actor.collider.pos = pos;
        }

        let count = tiledobj_get_count(map, "text");
        for i in 0..count {
            // Assume that these objects are all the player spawn postiion.
            let pos = round2(tiledobj_get_position(map, "text", i) + (0, 12));
            let text = tiledobj_get_text(map, "text", i) else continue;

            let hide = tiledobj_get_property_int(map, "text", i, "cutscene") == 1;

            text_objects.push(new TextObject {
                pos: pos,
                text: text,
                hide: hide,
            })
        }
    }

    fun draw_bg() {
        let map = cur_map else return;
        let size = map_size * 16;

        // // Draw a bordering black rectangle around the entire map.
        // // This is so we don't have to manually set this up in Tiled.
        // let TILE_DARK_BORDER = (#1c1c1bff);
        // let BORDER_SIZE = 16 * 32;
        // // left and right strips
        // draw_rectangle((-BORDER_SIZE, -BORDER_SIZE), (BORDER_SIZE, size.y + BORDER_SIZE * 2), TILE_DARK_BORDER);
        // draw_rectangle((size.x, -BORDER_SIZE), (BORDER_SIZE, size.y + BORDER_SIZE * 2), TILE_DARK_BORDER);
        // // top and bottom strips
        // draw_rectangle((-BORDER_SIZE, -BORDER_SIZE), (size.x + BORDER_SIZE * 2, BORDER_SIZE), TILE_DARK_BORDER);
        // draw_rectangle((-BORDER_SIZE, size.y), (size.x + BORDER_SIZE * 2, BORDER_SIZE), TILE_DARK_BORDER);

        draw_map(map, "bg", (0, 0, size.x, size.y));
    }

    fun draw() {
        let map = cur_map else return;
        let size = map_size * 16;
        draw_map(map, MAIN_LAYER, (0, 0, size.x, size.y));
        draw_map(map, "fg", (0, 0, size.x, size.y));
    }
}

let world_loader = new WorldLoader{};
var debug = 0;

fun update_dt(dt: float) {
    world.pre_physics_step();

    // if debug == 0 {
    //     debug = 1;
    //     world.actors[1].collider.pos.x -= 1;
    // }    

    // Update keys for is_just_pressed tracking
    for i in 0..keys.length {
        keys[i].update();
    }

    // Moving platforms go before other physics objects.
    for i in 0..moving_platforms.length {
        moving_platforms[i].update_dt(dt);
    }
    for i in 0..plant_detect_v.length {
        plant_detect_v[i].update_dt(dt);
    }

    crates_pending = crates;
    for i in 0..crates.length {
        crates[i].update_dt(dt);
    }
    crates = crates_pending;

    player.update_dt(dt);
    world_loader.tick();

    screen_transition.update_dt(dt);
    //var cam_target = -player.actor.collider.pos;
    //screen.target_offset += (cam_target - screen.target_offset) * 1;//0.03;
}

fun draw() {
    if is_font_loaded(main_font) {
        set_font_filter_mode(main_font, FILTER_NEAREST);
    }

    //screen.target_offset = -(player.actor.collider.pos + (8, 8));
    camera_controller.ready_draw((player.actor.collider.pos + (8, 8)));
    screen.update();

    draw_texture(tex.parallax_bg, -screen.target_offset - (240, 180)/2, (#ffff));

    world_loader.draw_bg();
    // let layer = world.layers[0];
    // var y = 0;
    // var ndx = 0;
    // while ndx < layer.colliders.length {
    //     for x in 0..layer.width {
    //         let tile = layer.colliders[ndx];
    //         if tile != T_EMPTY {
    //             draw_rectangle((x * 16, y * 16), (16, 16), (#4d35d6ff));
    //         }
    //         ndx += 1;
    //     }
    //     y += 1;
    // }

    

    world_loader.draw();

    for i in 0..text_objects.length {
        text_objects[i].draw();
    }


    for i in 0..moving_platforms.length {
        moving_platforms[i].draw();
    }
    for i in 0..plant_detect_v.length {
        plant_detect_v[i].draw();
    }

    // for i in 0..world.solids.length {
    //     let solid = world.solids[i];
    //     //print("draw crate @ ", solid.collider.pos);
    //     draw_texture_flip_frame(tex.tiles, solid.collider.pos - (1, 1), false, false, (16, 16, 16, 16), (#ffff));
    // }
    for i in 0..crates.length {
        let crate = crates[i];
        crate.draw();
    }

    player.draw();

    screen_transition.draw();
}

class ScreenTransition {
    var t: float = 0;
    var active: bool = false;
    var waiting_on_world = false;

    fun trigger() {
        if active { return; }
        active = true;
        t = 0;
    }

    /// Whether we are ready to load the level.
    fun is_ready() -> bool {
        return t >= 1;
    }

    fun update_dt(dt: float) {
        if active {
            t += dt * 6.0;
            // We let the world loader deactivatee us for now.
            if t >= 3 and not waiting_on_world { active = false; }
        }
    }

    fun draw() {
        if active {
            let size = screen.target_size;
            let tl_corner = -screen.target_offset - size / 2;
            if t <= 1 {
                let t = ease_out_cubic(t);
                draw_rectangle(tl_corner, (size.x * t, size.y), (#000f));
            }
            else {
                if t <= 2 {
                    draw_rectangle(tl_corner, size, (#000f));
                }
                else {
                    let t = ease_in_cubic(t - 2);
                    draw_rectangle(tl_corner + (size.x * t, 0), (size.x * (1 - t), size.y), (#000f));
                }
            }
        }
    }
}
let screen_transition = new ScreenTransition{};

fun ease_out_cubic(t: float) -> float {
    let t = 1 - t;
    let t = t * t * t;
    return 1 - t;
}

fun ease_in_cubic(t: float) -> float {
    return t * t * t;
}